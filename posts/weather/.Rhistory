library(nycflights13)
library(dplyr)
library(ggplot2)
# Load dataset into memory
data("weather", package = "nycflights13")
head(weather)
#| label: temp-anova-test
#| echo: true
# Fit ANOVA model testing temperature differences across origins
anova_model <- aov(temp ~ origin, data = weather_clean)
#| label: fig-temp-distributions
#| fig-cap: "Temperature distributions and medians across EWR, JFK, and LGA airports."
#| echo: true
weather_clean <- weather |> filter(!is.na(temp))
ggplot(weather_clean, aes(x = origin, y = temp, fill = origin)) +
geom_boxplot() +
labs(
title = "Temperature Distribution by NYC Airport",
subtitle = "Hourly records from 2013",
x = "Airport Code",
y = "Temperature (°F)"
) +
theme_minimal() +
theme(legend.position = "none")
#| label: temp-anova-test
#| echo: true
# Fit ANOVA model testing temperature differences across origins
anova_model <- aov(temp ~ origin, data = weather_clean)
anova_results <- summary(anova_model)
#| label: temp-anova-test
#| echo: true
# Fit ANOVA model testing temperature differences across origins
anova_model <- aov(temp ~ origin, data = weather_clean)
summary(anova_model)
#| label: temp-anova-test
#| echo: true
# Fit ANOVA model testing temperature differences across origins
anova_model <- aov(temp ~ origin, data = weather_clean)
anova_results <- summary(anova_model)
# Extract formatted model output
anova_table <- data.frame(
Source = c("Airport (Origin)", "Residuals"),
Df = c(anova_results[[1]]$Df[1], anova_results[[1]]$Df[2]),   Sum_Sq = round(c(anova_results[[1]]$`Sum Sq`[1], anova_results[[1]]$`Sum Sq`[2]), 1),
F_Value = round(c(anova_results[[1]]$`F value`[1], NA), 2),
P_Value = c(format.pval(anova_results[[1]]$`Pr(>F)`[1], eps = 0.001), NA)
)
anova_table
#| label: setup
