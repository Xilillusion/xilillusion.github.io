#| label: setup
#| message: false
#| warning: false
library(COUNT)
library(dplyr)
library(ggplot2)
# Load dataset into memory
data("fishing", package = "COUNT")
#| label: chunk-summary-stats
#| echo: true
# Chunk 1: Calculate summary statistics for income across fishing modes
mode_summary <- fishing |>
group_by(mode) |>
summarize(
count = n(),
mean_income = mean(income, na.rm = TRUE),
median_income = median(income, na.rm = TRUE)
) |>
arrange(desc(mean_income))
#| label: setup
#| message: false
#| warning: false
library(COUNT)
library(dplyr)
library(ggplot2)
# Load dataset into memory
data("fishing", package = "COUNT")
head(fishing)
#| label: chunk-summary-stats
#| echo: true
mode_summary <- fishing |>
group_by(period) |>
summarize(
count = n(),
mean_density = mean(density, na.rm = TRUE),
median_density = median(density, na.rm = TRUE)
) |>
arrange(desc(mean_density))
mode_summary
#| label: chunk-summary-stats
#| echo: true
mode_summary <- fishing |>
group_by(year) |>
summarize(
count = n(),
mean_density = mean(density, na.rm = TRUE),
median_density = median(density, na.rm = TRUE)
) |>
arrange(desc(mean_density))
mode_summary
#| label: chunk-summary-stats
#| echo: true
mode_summary <- fishing |>
group_by(year) |>
summarize(
mean_density = mean(density, na.rm = TRUE),
median_density = median(density, na.rm = TRUE)
) |>
arrange(desc(mean_density))
mode_summary
#| label: chunk-summary-stats
#| echo: true
mode_summary <- fishing |>
group_by(year) |>
summarize(
count = n(),
mean_density = mean(density, na.rm = TRUE),
median_density = median(density, na.rm = TRUE)
) |>
arrange(desc(year))
mode_summary
#| label: chunk-summary-stats
#| echo: true
mode_summary <- fishing |>
group_by(year) |>
summarize(
count = n(),
mean_density = mean(density, na.rm = TRUE),
median_density = median(density, na.rm = TRUE)
) |>
arrange(desc(mean_density))
mode_summary
#| label: period-summary-stats
#| echo: true
mode_summary <- fishing |>
group_by(period) |>
summarize(
count = n(),
mean_density = mean(density, na.rm = TRUE),
median_density = median(density, na.rm = TRUE)
) |>
arrange(desc(mean_density))
mode_summary
#| label: fig-density-trends
#| fig-cap: "Trends in fish density tracked across observation periods and faceted by year."
#| echo: true
ggplot(fishing, aes(x = period, y = density)) +
geom_line(color = "#2b5c8f", linewidth = 1) +
geom_point(color = "#2b5c8f", size = 2) +
facet_wrap(~ year) +
labs(
x = "Observation Period",
y = "Fish Density",
title = "Fish Density Trends Across Periods and Years"
) +
theme_minimal()
#| label: fig-yearly-density
#| fig-cap: "Distribution of fish density across observation years."
#| echo: true
ggplot(fishing, aes(x = factor(year), y = density)) +
geom_boxplot(fill = "steelblue", alpha = 0.4, outlier.shape = NA) +
geom_jitter(width = 0.15, alpha = 0.6, color = "darkblue") +
labs(
x = "Year",
y = "Fish Density",
title = "Yearly Fish Density Distribution"
) +
theme_minimal()
